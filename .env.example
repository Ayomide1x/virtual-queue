# Copy to .env (or run `npm run setup:alerts`, which creates it with fresh VAPID keys).

# Base URL phones use. Web push needs HTTPS, e.g. a tunnel: https://your-name.trycloudflare.com
PUBLIC_URL=

# Web push (VAPID). Generate with: npm run setup:alerts
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email fallback via Resend (free tier). Leave empty to log emails instead (addresses masked).
RESEND_API_KEY=
EMAIL_FROM=Virtual Queue <onboarding@resend.dev>
