# Production settings for a server behind Caddy. Copy to the repo root as .env
# (it's git-ignored) and fill in your values: cp deploy/env.production.example .env

# Listen only on this machine. Caddy is the only way in from the internet.
BIND_IP=127.0.0.1
# Pick a port nothing else uses (check: sudo ss -tlnp | grep 3210).
PORT=3210

# The address residents use. Lobby QR codes and alert links are built from it.
PUBLIC_URL=https://queue.example.com
# Caddy adds X-Forwarded-For; trust exactly one proxy hop so rate limits see real client IPs.
TRUST_PROXY=1

NODE_ENV=production
TZ=America/Chicago
LOG_LEVEL=info
# APP_VERSION is shown by /health and attached to error reports, e.g. APP_VERSION=$(git rev-parse --short HEAD)
APP_VERSION=

# Error tracking (optional): a Sentry or GlitchTip project DSN.
SENTRY_DSN=

# Alerts (optional). Generate VAPID keys once (see deploy/README.md).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
RESEND_API_KEY=
EMAIL_FROM=Virtual Queue <alerts@example.com>
